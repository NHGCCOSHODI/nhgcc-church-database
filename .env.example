# ===================================================================
# NHGCC Church Management System - Environment Configuration
# ===================================================================

# Secret key for session encryption & CSRF protection
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Cloud Database URL (Required for multi-user production)
# Examples:
# Neon.tech: postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/nhgcc_db?sslmode=require
# Supabase:  postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Church Organization Details
CHURCH_NAME=National Holy Ghost Church of Christ
CHURCH_BRANCH=Oshodi Parish, Lagos
CHURCH_EMAIL=nhgccoshodi@gmail.com
CHURCH_PHONE=+2348034540716
CHURCH_FACEBOOK=https://www.facebook.com/nhgccoshodii/

# SMTP Email Dispatch Settings (Gmail App Password or SendGrid/Resend)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=NHGCC Oshodi Secretariat <nhgccoshodi@gmail.com>
